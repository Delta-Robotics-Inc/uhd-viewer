                      "fontSize": 9,
                      "fontWeight": "normal",
                      "letterSpacing": 0.4
                    }
                  ]
                }
              ]
            },
            {
              "id": "q1jURK",
              "type": "ref",
              "ref": "kRD5j",
              "name": "UHD Support",
              "width": "fill_container",
              "stroke": "$sup-partial",
              "descendants": {
                "H526p": {
                  "fill": "$sup-partial"
                },
                "EBeur": {
                  "content": "UHD MODEL: PARTIAL"
                },
                "YgzRP": {
                  "content": "Unresolved slots are reported (ConnectionResult.unresolvedSlots) and sub-links carry diagnostics, but a sub-link has no state of its own, so a single conductor can't be coloured partial or incompatible. Needed: a state field per sub-link."
                }
              }
            }
          ]
        }
      ]
    },

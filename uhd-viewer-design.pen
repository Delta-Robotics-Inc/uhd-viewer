        {
          "type": "text",
          "id": "KWZZL",
          "name": "Description",
          "fill": "$text-muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "A composed link (I2C, UART, 3-phase motor) can be opened like cutting into a real cable. The line splits into its child links, each ending on a child interface port, and closes back into one line when collapsed. While it's open, child links can be inspected and remapped by dragging a conductor end onto another child port.",
          "lineHeight": 1.5,
          "fontFamily": "$font-ui",
          "fontSize": 11,
          "fontWeight": "normal"
        },

              ]
            },
            {
              "type": "frame",
              "id": "leyl1",
              "name": "Note",
              "width": "fill_container",
              "fill": "$card-fill",
              "cornerRadius": 8,
              "stroke": "$card-stroke",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 6,
              "padding": 14,
              "children": [
                {
                  "type": "text",
                  "id": "p55oAh",
                  "name": "Note text",
                  "fill": "$text-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Detailed mode looks like a ribbon cable: every signal runs end to end in its own colour at a tight pitch over a soft band in the link's colour, from slim handles whose dots are only slightly wider than their lines. The + box expands it: the ribbon curves out into labelled lanes on the grid in the middle of the run and back into the ribbon before the far module; the − box at the breakout collapses it.\n\nRequirement: the label + toggle is one handle that can be dragged along the link's path (routed links bend, so the midpoint is only the default). Its position is stored as a distance along the route in the display file and follows the route when it is re-routed.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 11,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },

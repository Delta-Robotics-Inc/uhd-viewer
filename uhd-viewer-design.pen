              "ref": "kRD5j",
              "name": "UHD Support",
              "width": "fill_container",
              "stroke": "$sup-gap",
              "descendants": {
                "H526p": {
                  "fill": "$sup-gap"
                },
                "EBeur": {
                  "content": "UHD MODEL: GAP"
                },
                "YgzRP": {
                  "content": "No export/promotion exists. InterfaceDef.exposed only marks an interface as externally connectable; ChildModuleRef.exposedInterfaces is declared but never read, and nothing maps a parent interface to a child's. A group (children, no own interfaces) therefore has an empty external surface. Needed: ModuleDef.exports [{id, from:{child, interfaceId}}] and kind:'group' (or exportAll) meaning 'export every child's exposed interfaces'."
                }
              }
            }
          ]

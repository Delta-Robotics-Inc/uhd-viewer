            {
              "type": "frame",
              "id": "atnXM",
              "name": "Note",
              "width": "fill_container",
              "fill": "$card-fill",
              "cornerRadius": 8,
              "stroke": "$card-stroke",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 6,
              "padding": 14,
              "children": [
                {
                  "type": "text",
                  "id": "auKJ5",
                  "name": "Note text",
                  "fill": "$text-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Basic mode keeps one line at each module: it is one link. Collapsed: a single line with a rounded + box at its centre and the count. Expanded: the line flows out into one labelled lane per signal group, the outer lanes peeling off first and the inner ones last, then rejoins in reverse before the far module; the − box sits at the centre and spans every lane. The toggle is always at the centre of the link, sized to what it spans.\n\nRequirement: the label + toggle is one handle that can be dragged along the link's path (routed links bend, so the midpoint is only the default). Its position is stored as a distance along the route in the display file and follows the route when it is re-routed.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 11,
                  "fontWeight": "normal"
                }
              ]
            }
          ]

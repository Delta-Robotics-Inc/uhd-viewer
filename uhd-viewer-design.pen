      "gap": 28,
      "padding": 36,
      "children": [
        {
          "type": "text",
          "id": "k3M2v",
          "name": "Title",
          "fill": "$text-primary",
          "content": "07 · MODULE HIERARCHY",
          "fontFamily": "$font-ui",
          "fontSize": 18,
          "fontWeight": "normal",
          "letterSpacing": 1
        },
        {
          "type": "text",
          "id": "GTsGB",
          "name": "Description",
          "fill": "$text-muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "An expanded module shows its submodules one level below. A GROUP is a module with no interfaces of its own: by default it exports all of its children's interfaces, so neighbours attach at the group boundary (dashed outline, pass-through ports). A REAL MODULE with submodules has its own interfaces on its boundary (solid outline), linked internally to its children and externally to neighbours. Drilling in either expands in place or replaces the canvas; the header breadcrumb always shows the path.",
          "lineHeight": 1.5,
          "fontFamily": "$font-ui",
          "fontSize": 11,
          "fontWeight": "normal"
        },

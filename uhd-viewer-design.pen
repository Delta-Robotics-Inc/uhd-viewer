                  "id": "mCGd8",
                  "name": "Note text",
                  "fill": "$text-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The router works on the 16 px grid: it avoids modules and labels, penalises crossings and extra bends, and separates parallel runs one grid step apart. Its bends are automatic waypoints (hollow, blue), shown when a link is selected. Dragging one pins it: it turns solid orange with a pin, is saved in the display file, and the router must pass through it from then on. Double-clicking a fixed waypoint releases it.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 11,
                  "fontWeight": "normal"
                }

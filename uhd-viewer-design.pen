        },
        {
          "type": "text",
          "id": "JAWCy",
          "name": "Description",
          "fill": "$text-muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Two modules connect interfaces directly through an interface link. A 1:1 connection needs no harness entity. Links route orthogonally with filleted 90° corners, like an EDA schematic but for any hardware domain. Every link has three movable labels: the interface name at each end and the link name on the line.",
          "lineHeight": 1.5,
          "fontFamily": "$font-ui",
          "fontSize": 11,
          "fontWeight": "normal"
        },
